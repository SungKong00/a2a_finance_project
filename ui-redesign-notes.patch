+    # 2. send_message(agent="fundamental_analyst", message="Analyze AAPL")
+    # 3. send_message(agent="sentiment_analyst", message="Analyze AAPL")
+    # 4. send_message(agent="risk_assessor", message="Analyze AAPL")
+    # 총 소요시간: ~40초
